# YourHealthTip GenLayer Intelligent Contract Environment Configuration
# Copy this file to .env.local to configure your live GenLayer contract deployment.

# Deployed GenLayer Contract Address (from GenLayer Studio / testnet deployment)
VITE_GENLAYER_CONTRACT_ADDRESS=

# Optional custom RPC URL (defaults to studionet if omitted)
# VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Feature flag to switch from MockTipService to GenLayerTipService
VITE_USE_GENLAYER_CONTRACT=false
